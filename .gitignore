# RODO: local state (and, once a board is bound, card files: they live on the board)
rodo/*/.rodo/
rodo/*/inbox/

# Graphify code map (rebuilt locally with `graphify update .`)
graphify-out/

# PlatformIO / build output
.pio/
firmware/.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# KiCad
*-backups/
*.kicad_prl
fp-info-cache
_autosave-*
*.bak
\#auto_saved_files#

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# Secrets (WiFi passwords, bot tokens)
secrets.h
.env

rodo/**/*.rodo.md

# Device secrets (default passwords): copy firmware/src/secrets.example.h to firmware/src/secrets.h
firmware/src/secrets.h

# Generated from firmware/web/* by scripts/embed_web.py at every build
firmware/lib/web/panel_files.h
